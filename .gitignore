# ==============================================================================
# Comprehensive .gitignore for AI Code Review Monorepo
# Includes Next.js, Node.js, Express, TypeScript, Python, Databases & System Files
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dependencies & Package Managers
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
jspm_packages/
web_modules/

# ------------------------------------------------------------------------------
# 2. Build Outputs & Compilers
# ------------------------------------------------------------------------------
dist/
**/dist/
build/
**/build/
out/
**/out/
.next/
**/.next/
.swc/
.turbo/
.cache/
.parcel-cache/
*.tsbuildinfo
.eslintcache
.stylelintcache

# ------------------------------------------------------------------------------
# 3. Environment Variables & Credentials (Never Commit Secrets!)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test.example
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!**/.env.example

# Cryptographic Keys & Certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.id_dsa
id_ed25519
id_rsa
secrets.json
credentials.json

# ------------------------------------------------------------------------------
# 4. Logs, Crash Dumps & Diagnostics
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
core.[0-9]*
*.stackdump

# ------------------------------------------------------------------------------
# 5. Testing & Code Coverage
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov
.vitest/
.jest/
test-results/
playwright-report/
blob-report/
playwright/.cache/

# ------------------------------------------------------------------------------
# 6. Database & Local Storage Files
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite3-journal
*.db
*.db-journal
*.db-shm
*.db-wal
*.sql.gz
*.sql.bak
dump.rdb

# ------------------------------------------------------------------------------
# 7. Python & Multi-Language Virtual Environments (for Scanned Code)
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.venv/
**/venv/
**/env/
**/ENV/
env.bak/
venv.bak/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 8. IDE, Editor & Tooling Caches
# ------------------------------------------------------------------------------
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# JetBrains (IntelliJ, WebStorm, PyCharm)
.idea/
*.iml
*.iws
*.ipr

# Sublime Text & TextMate
*.sublime-workspace
*.sublime-project
*.tmproj
*.tmproject

# Vim / Emacs
*.swp
*.swo
*~
.#*
\#*\#

# ------------------------------------------------------------------------------
# 9. Operating System Artifacts
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# Linux
.directory
.fuse_hidden*
.Trash-*

# ------------------------------------------------------------------------------
# 10. Temporary, Scratch & AI Assistant Generated Files
# ------------------------------------------------------------------------------
tmp/
temp/
scratch/
**/scratch/
.system_generated/
**/.system_generated/
.gemini/
.antigravity/
.agy/
