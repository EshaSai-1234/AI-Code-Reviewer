generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  files     File[]
}

model File {
  id        String   @id @default(cuid())
  path      String
  content   String   @db.Text
  project   Project  @relation(fields: [projectId], references: [id])
  projectId String
}
